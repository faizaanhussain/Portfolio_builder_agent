# ==============================================================================
# Portfolio Agent Environment Configuration
# ==============================================================================

# LLM Provider API Key (Required for live generation)
# Supports OpenAI, Groq, OpenRouter, DeepSeek, Ollama, etc.
OPENAI_API_KEY=your_api_key_here

# Base URL (Optional - leave empty for standard OpenAI API)
# Examples:
# Groq:        https://api.groq.com/openai/v1
# OpenRouter:  https://openrouter.ai/api/v1
# DeepSeek:    https://api.deepseek.com/v1
# Local Ollama:http://localhost:11434/v1
# OpenAI:      https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Name
# Recommended: llama-3.3-70b-versatile, gpt-4o, gpt-4o-mini, deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# Sandboxed Workspace Directory (Relative or Absolute)
WORKSPACE_DIR=./generated_sites

# Agent Settings
AGENT_MAX_TURNS=25
AGENT_TEMPERATURE=0.7

# Preview Server Settings
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=8000
